# Attunly Environment Variables
# Copy this to .env.local and fill in real values

# ===================
# PUBLIC (Client-safe)
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================
# PRIVATE (Server-only)
# ===================

# Supabase Admin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (for direct postgres access)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Admin Secret (generate a random string: openssl rand -hex 32)
# Required for migration endpoints
ADMIN_SECRET=generate-a-random-secret-here

# Encryption Key (generate with: openssl rand -hex 32)
# Required for encrypting sensitive tokens at rest
ENCRYPTION_KEY=

# ===================
# SLACK INTEGRATION
# ===================
# Get these from https://api.slack.com/apps

# OAuth credentials for Slack login
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Bot token (xoxb-...) - Required for sending DMs and messages
# Get this after installing the app to your workspace
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx

# Signing secret - Required for verifying Slack requests
SLACK_SIGNING_SECRET=

# Optional: Legacy webhook for channel notifications (fallback)
SLACK_WEBHOOK_URL=

# ===================
# CRON JOBS
# ===================
# Secret for authenticating cron job requests (generate with: openssl rand -hex 32)
# Required in production for momentum lock expiration checks
CRON_SECRET=

# ===================
# EMAIL NOTIFICATIONS
# ===================
# Using MailerSend for transactional emails
# Get credentials from https://app.mailersend.com/

MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=notifications@attunly.app
MAILERSEND_FROM_NAME=Attunly

# ===================
# AI / SEMANTIC SEARCH
# ===================
# Groq - FREE tier (14,400 requests/day)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxx
