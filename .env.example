# Attunly Environment Variables
# Copy this to .env.local and fill in real values

# ===================
# PUBLIC (Client-safe)
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================
# PRIVATE (Server-only)
# ===================

# Supabase Admin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (for direct postgres access)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Admin Secret (generate a random string: openssl rand -hex 32)
# Required for migration endpoints
ADMIN_SECRET=generate-a-random-secret-here

# Encryption Key (generate with: openssl rand -hex 32)
# Required for encrypting sensitive tokens at rest
ENCRYPTION_KEY=

# ===================
# SLACK INTEGRATION
# ===================
# Required for Slack OAuth login and notifications
# Get these from https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional: Legacy webhook for channel notifications
# OAuth DMs are preferred and will be used automatically when users connect via Slack
SLACK_WEBHOOK_URL=

# ===================
# EMAIL NOTIFICATIONS
# ===================
# Required for email notifications (meeting invites, etc.)
# Get these from https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender email (must be verified in Resend)
# Format: "Display Name <email@domain.com>"
RESEND_FROM_EMAIL=Attunly <notifications@attunly.app>

# ===================
# AI / SEMANTIC SEARCH
# ===================
# Groq - FREE tier (14,400 requests/day)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxx
